# LLM Provider Configuration: 'gemini' (Google Gemini API) or 'ollama' (Local free pre-trained models)
LLM_PROVIDER=gemini

# Local Pre-trained Model Configuration (Ollama)
# Popular models: llama3.2, llama3.3, mistral, qwen2.5-coder, deepseek-coder, deepseek-r1, phi3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Backend configuration
DATABASE_URL=sqlite:///database/business.db
PORT=8000
HOST=127.0.0.1
JWT_SECRET=supersecretjwtkey_insightgen_2026

# Frontend configuration
VITE_API_URL=http://localhost:8000

