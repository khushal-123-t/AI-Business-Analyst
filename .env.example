# LLM Provider Configuration: 'gemini' (Sole AI Provider)
LLM_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Database Configuration
# Default/Local SQLite (NOTE: On Render's free tier, filesystem is ephemeral and resets on redeploy):
DATABASE_URL=sqlite:///database/business.db
# For production persistence, use Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@host/dbname

# Server Configuration
PORT=8000
HOST=0.0.0.0
JWT_SECRET=supersecretjwtkey_insightgen_2026
CSV_CHUNK_SIZE=10000

# CORS & Frontend Origins (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app

# Frontend configuration (for frontend/.env)
VITE_API_URL=https://ai-business-analyst-20jn.onrender.com

